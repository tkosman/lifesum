FROM python:3.12-slim AS base

RUN apt-get update && apt-get install -y \
    build-essential \
    libffi-dev \
    libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gateway.txt /

RUN pip install --upgrade pip \
    && pip install -r /requirements-gateway.txt

ENTRYPOINT [ "/bin/bash" ]
